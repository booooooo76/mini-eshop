{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SwaggerAggregator": {
    "Endpoints": [
      { "Url": "http://localhost:8081/openapi/v1.json", "Name": "Catalog.Api" },
      { "Url": "http://localhost:8082/openapi/v1.json", "Name": "Orders.Api" },
      { "Url": "http://localhost:8083/openapi/v1.json", "Name": "Notifications.Api" },
      { "Url": "http://localhost:8084/openapi/v1.json", "Name": "Reviews.Api" }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/catalog" } ]
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/orders" } ]
      },
      "notifications-route": {
        "ClusterId": "notifications-cluster",
        "Match": { "Path": "/notifications/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/notifications" } ]
      },
      "reviews-route": {
        "ClusterId": "reviews-cluster",
        "Match": { "Path": "/reviews/{**catch-all}" },
        "Transforms": [ { "PathRemovePrefix": "/reviews" } ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://catalog-api:8080" }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://orders-api:8080" }
        }
      },
      "notifications-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://notifications-api:8080" }
        }
      },
      "reviews-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://reviews-api:8080" }
        }
      }
    }
  }
}
